{
  "name": "keil-assistant",
  "displayName": "Keil Assistant",
  "description": "An assistant for Keil uVision (ARM & C51) with clangd support and high performance",
  "version": "2.0.0",
  "publisher": "in-ci",
  "author": {
    "name": "in-ci"
  },
  "keywords": [
    "keil",
    "mdk",
    "c51",
    "8051",
    "stm32",
    "clangd",
    "embedded"
  ],
  "homepage": "https://github.com/in-ci/keil-assistant",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/*.uvproj",
    "workspaceContains:**/*.uvprojx"
  ],
  "icon": "res/icons/icon.png",
  "main": "./dist/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/in-ci/keil-assistant.git"
  },
  "bugs": {
    "url": "https://github.com/in-ci/keil-assistant/issues"
  },
  "contributes": {
    "configuration": [
      {
        "title": "Keil Assistant",
        "properties": {
          "KeilAssistant.C51.Uv4Path": {
            "type": "string",
            "scope": "machine",
            "markdownDescription": "C51 UV4.exe path",
            "default": "null"
          },
          "KeilAssistant.MDK.Uv4Path": {
            "type": "string",
            "scope": "machine",
            "markdownDescription": "MDK UV4.exe path",
            "default": "null"
          },
          "KeilAssistant.Project.ExcludeList": {
            "type": "array",
            "scope": "resource",
            "markdownDescription": "uVision project file name exclude list",
            "default": [
              "template.uvproj",
              "template.uvprojx"
            ]
          },
          "KeilAssistant.Project.FileLocationList": {
            "type": "array",
            "scope": "resource",
            "markdownDescription": "uVision project file locations",
            "default": []
          }
        }
      }
    ],
    "commands": [
      {
        "command": "explorer.open",
        "title": "Open keil uVision project",
        "icon": {
          "light": "./res/icons/ClassAdded_16x.svg",
          "dark": "./res/icons/ClassAdded_16x.svg"
        }
      },
      {
        "command": "project.switch",
        "title": "Switch Target",
        "icon": {
          "light": "./res/icons/SwitchSourceOrTarget_16x.svg",
          "dark": "./res/icons/SwitchSourceOrTarget_16x.svg"
        }
      },
      {
        "command": "project.active",
        "title": "Active Project"
      },
      {
        "command": "project.close",
        "title": "Close Project",
        "icon": {
          "light": "./res/icons/StatusOffline_16x.svg",
          "dark": "./res/icons/StatusOffline_16x.svg"
        }
      },
      {
        "command": "project.setWorkspaceRoot",
        "title": "Set Workspace Root",
        "category": "Keil Assistant"
      },
      {
        "command": "project.build",
        "title": "Build",
        "icon": {
          "light": "./res/icons/BuildSelection_16x.svg",
          "dark": "./res/icons/BuildSelection_16x.svg"
        }
      },
      {
        "command": "project.download",
        "title": "Download To Device",
        "icon": {
          "light": "./res/icons/TransferDownload_16x.svg",
          "dark": "./res/icons/TransferDownload_16x.svg"
        }
      },
      {
        "command": "project.buildAndDownload",
        "title": "Build And Download",
        "icon": {
          "light": "./res/icons/BuildAndDownload_16x.svg",
          "dark": "./res/icons/BuildAndDownload_16x.svg"
        }
      },
      {
        "command": "project.rebuild",
        "title": "Rebuild",
        "icon": {
          "light": "./res/icons/BuildSolution_16x.svg",
          "dark": "./res/icons/BuildSolution_16x.svg"
        }
      },
      {
        "command": "item.copyValue",
        "title": "Copy Item Value",
        "icon": {
          "light": "./res/icons/CopyToClipboard_16x.svg",
          "dark": "./res/icons/CopyToClipboard_16x.svg"
        }
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "explorer.open",
          "group": "navigation",
          "when": "view == project"
        }
      ],
      "view/item/context": [
        {
          "command": "project.close",
          "when": "viewItem == Project"
        },
        {
          "command": "project.active",
          "when": "viewItem == Project"
        },
        {
          "command": "project.setWorkspaceRoot",
          "when": "viewItem == Project"
        },
        {
          "command": "project.switch",
          "group": "inline",
          "when": "viewItem == Project"
        },
        {
          "command": "project.build",
          "group": "inline@1",
          "when": "viewItem == Target"
        },
        {
          "command": "project.download",
          "group": "inline@2",
          "when": "viewItem == Target"
        },
        {
          "command": "project.rebuild",
          "group": "inline@3",
          "when": "viewItem == Target"
        },
        {
          "command": "project.buildAndDownload",
          "group": "inline@4",
          "when": "viewItem == Target"
        },
        {
          "command": "item.copyValue",
          "group": "inline",
          "when": "viewItem == Source"
        }
      ]
    },
    "keybindings": [
      {
        "command": "project.build",
        "key": "f7"
      },
      {
        "command": "project.download",
        "key": "ctrl+alt+d"
      },
      {
        "command": "project.rebuild",
        "key": "ctrl+alt+f7"
      },
      {
        "command": "project.buildAndDownload",
        "key": "ctrl+alt+b"
      }
    ],
    "snippets": [
      {
        "language": "a51",
        "path": "./syntaxes/a51.snippets.json"
      }
    ],
    "languages": [
      {
        "id": "a51",
        "aliases": [
          "A51",
          "8051 Assembly"
        ],
        "extensions": [
          ".a51",
          ".A51"
        ],
        "filenamePatterns": [
          "**/*.a51",
          "**/*.A51"
        ],
        "configuration": "./syntaxes/a51.language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "a51",
        "scopeName": "source.asm.a51",
        "path": "./syntaxes/a51.tmLanguage.json"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "project",
          "icon": "",
          "name": "Keil uVision Project"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "keil-task"
      }
    ],
    "problemMatchers": [
      {
        "name": "c51",
        "fileLocation": "autoDetect",
        "pattern": [
          {
            "regexp": "^([^\\(]+)\\(([\\d]+)\\):\\s+(error|warning)\\s+([A-Z0-9]+):\\s+(.+)$",
            "file": 1,
            "location": 2,
            "severity": 3,
            "code": 4,
            "message": 5
          }
        ]
      },
      {
        "name": "armcc",
        "fileLocation": "autoDetect",
        "pattern": [
          {
            "regexp": "^([^\\(]+)\\(([\\d]+)\\):\\s+(error|warning):\\s+#([\\d\\w-]+):\\s+(.+)$",
            "file": 1,
            "location": 2,
            "severity": 3,
            "code": 4,
            "message": 5
          }
        ]
      },
      {
        "name": "gcc",
        "fileLocation": "autoDetect",
        "pattern": [
          {
            "regexp": "^(.+):(\\d+):(\\d+):\\s+(\\w+):\\s+(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "webpack --mode production",
    "webpack": "webpack --mode development",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware src",
    "check": "pnpm run typecheck && pnpm run lint",
    "test": "pnpm run vscode:prepublish && vscode-test",
    "package": "pnpm run check && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@types/vscode": "~1.85.0",
    "@types/xml2js": "^0.4.14",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild-loader": "^4.5.0",
    "glob": "^13.0.6",
    "mocha": "^12.0.3",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "7.0.2",
    "webpack": "^5.112.0",
    "webpack-cli": "^7.2.3"
  },
  "dependencies": {
    "vscode-variables": "1.0.1",
    "xml2js": "^0.6.2"
  }
}
